# Servicio de usuario para SteamOS / Bazzite / Linux.
# cp scripts/orbital.service ~/.config/systemd/user/ && systemctl --user enable --now orbital
[Unit]
Description=Orbital (interfaz de consola)
After=graphical-session.target

[Service]
ExecStart=%h/orbital/.venv/bin/python -m orbital --ui none
Restart=on-failure

[Install]
WantedBy=default.target
