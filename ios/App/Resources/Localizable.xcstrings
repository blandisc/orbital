          "variations": {
            "device": {
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "On any movie or show, tap “Watch on TV”: it starts in the living room right where you left off. What's playing there shows above the tab bar, in “On TV”."
                }
              },
