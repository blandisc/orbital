                  "state": "translated",
                  "value": "If you want another one, tap the flag to the right of “Watch”."
                }
              },
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "If you want another one, click the flag to the right of “Watch”."
                }
              },
              "other": {
                "stringUnit": {
