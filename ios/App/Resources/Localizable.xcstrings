      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “Hey Siri, talk to Orbital” and, when it asks, the command. For the everyday ones, directly: “Hey Siri, pause Orbital” or “Hey Siri, resume Orbital”."
