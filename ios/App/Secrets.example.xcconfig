// Copia este archivo como Secrets.xcconfig (no va a git) y pon la clave de TMDB de Orbital (la misma de la consola,
// config.yaml › para_ti.tmdb_key). Con ella la app trae fichas en español sin pedir nada.
ORBITAL_TMDB_KEY =

// La clave de la app de Orbital en OpenSubtitles (opensubtitles.com/consumers, «Api-Key»). Sin ella, los subtítulos salen
// del complemento de siempre (pocos por idioma). Tu cuenta (usuario y contraseña) se conecta en la app, no aquí.
ORBITAL_OPENSUBTITLES_KEY =
